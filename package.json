{
  "name": "vto-eyewear",
  "private": true,
  "version": "0.1.0",
  "description": "Premium in-browser 3D virtual eyewear try-on engine (MediaPipe Face Landmarker + Three.js). Standalone app; WordPress plugin integration later.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "node tools/vendor-mediapipe.mjs",
    "vendor": "node tools/vendor-mediapipe.mjs",
    "canonical-face": "node tools/build-canonical-face.mjs",
    "models": "node tools/generate-models.mjs",
    "optimize-model": "node tools/optimize-model.mjs",
    "thumbs": "node tools/render-thumbs.mjs",
    "test:tracking": "node tests/run-tracking.mjs",
    "test:tracking:sweep": "node tests/run-tracking.mjs --sweep",
    "test:render": "node tests/run-render.mjs",
    "test:modal": "node tests/run-modal.mjs",
    "test": "npm run test:unit && npm run test:tracking && npm run test:render && npm run test:modal && npm run test:perf && npm run test:dist",
    "shots": "node tests/shots.mjs",
    "test:unit": "node tests/run-unit.mjs",
    "test:perf": "node tests/run-perf.mjs",
    "test:dist": "node tests/run-dist.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
